# Copy to .env and adjust. Every variable is optional.

# Host port (mapped to 8000 inside the container)
WNE_PORT=8000
WNE_PLAYWRIGHT_PORT=8001

# Maximum number of chapters in a single EPUB
WNE_MAX_CHAPTERS=300

# Delay between HTTP requests in seconds - be polite to other people's servers
WNE_REQUEST_DELAY=0.75
WNE_REQUEST_TIMEOUT=30
WNE_MAX_RETRIES=3

# Enables Playwright for ALL parsers (only works in the `playwright` image)
WNE_PLAYWRIGHT_ENABLED=false

# Default UI language when it cannot be detected from the browser
WNE_DEFAULT_LANGUAGE=en

# Save a copy of every finished EPUB to disk (on top of the browser download).
# Enabled in the ready-made CasaOS files - see deploy/
WNE_SAVE_TO_DISK=false
WNE_OUTPUT_DIR=output

WNE_LOG_LEVEL=INFO
# WNE_USER_AGENT=webnoveltoepub/0.1 (+https://github.com/SpookyDoge/webnoveltoepub)
