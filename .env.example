# Skopiuj do .env i dostosuj. Wszystkie zmienne sa opcjonalne.

# Port hosta (mapowany na 8000 w kontenerze)
WNE_PORT=8000
WNE_PLAYWRIGHT_PORT=8001

# Maksymalna liczba rozdzialow w jednym EPUB-ie
WNE_MAX_CHAPTERS=300

# Odstep miedzy zapytaniami HTTP w sekundach - badz uprzejmy dla cudzych serwerow
WNE_REQUEST_DELAY=0.75
WNE_REQUEST_TIMEOUT=30
WNE_MAX_RETRIES=3

# Wlacza Playwright dla WSZYSTKICH parserow (dziala tylko w obrazie `playwright`)
WNE_PLAYWRIGHT_ENABLED=false

# Domyslny jezyk UI, gdy nie da sie go wykryc z przegladarki
WNE_DEFAULT_LANGUAGE=en

WNE_LOG_LEVEL=INFO
# WNE_USER_AGENT=webnoveltoepub/0.1 (+https://github.com/SpookyDoge/webnoveltoepub)
